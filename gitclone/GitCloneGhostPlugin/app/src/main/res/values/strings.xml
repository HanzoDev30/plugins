    <string name="gitclone_chip_submodules">Submodules</string>
    <string name="gitclone_chip_shallow">Shallow</string>
    <string name="gitclone_chip_single">Single branch</string>
    <string name="gitclone_chip_notags">No tags</string>
    <string name="gitclone_chip_bare">Bare repository</string>

    <!-- Field labels -->
    <string name="gitclone_label_url">Repository URL</string>
    <string name="gitclone_label_target">Destination</string>
    <string name="gitclone_label_options">Options</string>

