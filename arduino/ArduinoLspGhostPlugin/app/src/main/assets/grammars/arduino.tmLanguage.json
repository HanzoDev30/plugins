{
  "name": "Arduino",
  "scopeName": "source.arduino",
  "fileTypes": ["ino", "pde"],
  "patterns": [
    { "include": "#line_comment" },
    { "include": "#block_comment" },
    { "include": "#preprocessor" },
    { "include": "#string" },
    { "include": "#char" },
    { "include": "#number" },
    { "include": "#keyword" },
    { "include": "#type" },
    { "include": "#framework" },
    { "include": "#constant" },
    { "include": "#variable" },
    { "include": "#function" },
    { "include": "#operator" }
  ],
  "repository": {
    "line_comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.arduino"
    },
    "block_comment": {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.arduino",
      "patterns": [
        {
          "match": "(@(?:param|return|brief|author|file|todo|note|warning|end))\\b",
          "name": "keyword.other.documentation.arduino"
        }
      ]
    },
    "preprocessor": {
      "begin": "^\\s*(#\\s*(?:include|define|undef|if|ifdef|ifndef|else|elif|endif|pragma|error|warning)\\b)",
      "beginCaptures": {
        "1": { "name": "keyword.control.directive.preprocessor.arduino" }
      },
      "end": "(?=^\\s*#)|(?=$)",
      "name": "meta.preprocessor.arduino",
      "patterns": [
        { "include": "#string" },
        { "include": "#char" },
        { "include": "#number" },
        {
          "match": "<[^>]*>",
          "name": "string.quoted.other.lt-gt.include.arduino"
        },
        {
          "match": "\\b[A-Za-z_]\\w*\\b",
          "name": "entity.name.function.preprocessor.arduino"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.arduino",
          "patterns": [
            {
              "match": "\\\\(?:[\\\\\"'?abfnrtv]|[0-7]{1,3}|x[0-9A-Fa-f]+)",
              "name": "constant.character.escape.arduino"
            }
          ]
        },
        {
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "name": "string.quoted.double.block.arduino"
        }
      ]
    },
    "char": {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single.arduino",
      "patterns": [
        {
          "match": "\\\\(?:[\\\\\"'?abfnrtv]|[0-7]{1,3}|x[0-9A-Fa-f]+)",
          "name": "constant.character.escape.arduino"
        }
      ]
    },
    "number": {
      "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|(?:\\d[\\d_]*)(?:\\.[\\d_]*)?(?:[eE][+-]?\\d+)?L?)\\b",
      "name": "constant.numeric.arduino"
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(if|else|for|while|do|switch|case|default|break|continue|return|goto|sizeof|typedef|struct|union|enum|class|public|private|protected|virtual|static|const|volatile|extern|inline|template|namespace|using|new|delete|try|catch|throw|this|operator|friend|mutable|explicit|register|asm)\\b",
          "name": "keyword.control.arduino"
        },
        {
          "match": "\\b(defined)\\b",
          "name": "keyword.operator.defined.arduino"
        }
      ]
    },
    "type": {
      "match": "\\b(void|bool|boolean|byte|char|unsigned|signed|short|int|long|float|double|word|String|auto|size_t|ssize_t|ptrdiff_t|uint8_t|uint16_t|uint32_t|uint64_t|int8_t|int16_t|int32_t|int64_t|byte_t|wchar_t|nullptr)\\b",
      "name": "storage.type.arduino"
    },
    "framework": {
      "match": "\\b(setup|loop|init|initVariant|pinMode|digitalWrite|digitalRead|analogRead|analogWrite|analogReference|analogReadResolution|analogWriteResolution|delay|delayMicroseconds|millis|micros|attachInterrupt|detachInterrupt|interrupts|noInterrupts|tone|noTone|pulseIn|pulseInLong|shiftOut|shiftIn|random|randomSeed|map|constrain|min|max|abs|sq|sqrt|pow|exp|log|log10|sin|cos|tan|asin|acos|atan|atan2|ceil|floor|round|hr|hh|mm|ss|hc|dl|dh|wc|wd|serialEvent|yield|fscale|isAlpha|isAlphaNumeric|isAscii|isControl|isDigit|isGraph|isHexadecimalDigit|isLowerCase|isPrintable|isPunct|isSpace|isUpperCase|isWhitespace|toLowerCase|toUpperCase|strlen|strcmp|strcpy|strcat|strncmp|strncpy|strchr|sprintf|sscanf|memcpy|memset)\\b",
      "name": "support.function.builtin.arduino"
    },
    "constant": {
      "match": "\\b(HIGH|LOW|CHANGE|FALLING|RISING|INPUT|OUTPUT|INPUT_PULLUP|LED_BUILTIN|LSBFIRST|MSBFIRST|DEC|BIN|OCT|HEX|true|false|NULL|PI|HALF_PI|TWO_PI|DEG_TO_RAD|RAD_TO_DEG|EULER)\\b",
      "name": "constant.language.arduino"
    },
    "variable": {
      "match": "\\b(Serial|Serial1|Serial2|Serial3|SPI|Wire|EEPROM|PROGMEM|SoftwareSerial|Stream|Arduino|Boot|String|byte|word|int|float|double)\\b",
      "name": "variable.language.arduino"
    },
    "function": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.function.arduino" }
      }
    },
    "operator": {
      "patterns": [
        {
          "match": "\\b(?:&&|\\|\\||!|==|!=|<=|>=|<|>|&=|\\|=|\\^=|<<=|>>=|\\+=|-=|\\*=|/=|%=|\\+\\+|--|<<|>>|&|\\||\\^|~|\\?)\\b?",
          "name": "keyword.operator.arduino"
        },
        {
          "match": "[\\[\\](){};,:.]",
          "name": "punctuation.arduino"
        }
      ]
    }
  }
}